{
  "name": "construction-company-records",
  "version": "2.0.0",
  "description": "Offline-first Windows desktop application for road construction record management",
  "main": "dist-electron/main.js",
  "author": "Daksh Construction System",
  "license": "MIT",
  "scripts": {
    "build:electron": "node esbuild.config.js",
    "build:ui": "vite build",
    "build": "npm run build:ui && npm run build:electron",
    "dev": "node scripts/dev.js",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win nsis",
    "test": "node scripts/run-tests.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.js"
  },
  "build": {
    "appId": "com.construction.recordmanager",
    "productName": "Construction Record Manager",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/archiver": "^6.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "archiver": "^5.3.2",
    "autoprefixer": "^10.6.2",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.74.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7"
  }
}
